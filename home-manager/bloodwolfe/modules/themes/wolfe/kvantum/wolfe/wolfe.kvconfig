[%General]
author=wolfe
comment=Minimal pitch-black square theme template
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
splitter_width=1
scroll_width=10
scroll_arrows=false
combo_as_lineedit=true
animate_states=false
transient_scrollbar=false

[GeneralColors]
window.color=#000000
base.color=#000000
alt.base.color=#080808
button.color=#080808
light.color=#303030
mid.light.color=#202020
dark.color=#000000
mid.color=#101010
highlight.color=#b000ff
inactive.highlight.color=#600080
text.color=#ffffff
window.text.color=#ffffff
button.text.color=#ffffff
disabled.text.color=#707070
tooltip.text.color=#ffffff
highlight.text.color=#000000
link.color=#b000ff
link.visited.color=#d080ff

[Hacks]
respect_darkness=true
blur_translucent=false
transparent_dolphin_view=false
transparent_pcmanfm_view=false

[PanelButtonCommand]
frame=false
interior=true
interior.element=button
text.normal.color=#ffffff
text.focus.color=#ffffff
text.press.color=#000000
text.toggle.color=#000000
text.margin=4

[PanelButtonTool]
inherits=PanelButtonCommand
interior.element=tbutton

[Dock]
inherits=PanelButtonCommand

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false

[RadioButton]
frame=false
interior=true
interior.element=radio
text.normal.color=#ffffff
text.focus.color=#ffffff
text.margin=3

[CheckBox]
inherits=RadioButton
interior.element=checkbox

[GenericFrame]
frame=false
interior=false

[LineEdit]
frame=false
interior=true
interior.element=lineedit
text.normal.color=#ffffff
text.focus.color=#ffffff
text.margin=4

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down
indicator.size=8

[IndicatorArrow]
indicator.element=arrow
indicator.size=8

[Tab]
inherits=PanelButtonCommand
interior.element=tab
text.margin=5

[TabFrame]
frame=false
interior=true
interior.element=tabframe

[Toolbar]
frame=false
interior=true
interior.element=toolbar

[Slider]
frame=false
interior=true
interior.element=slider

[SliderCursor]
frame=false
interior=true
interior.element=slidercursor

[Progressbar]
frame=false
interior=true
interior.element=progress

[ProgressbarContents]
frame=false
interior=true
interior.element=progress-pattern

[ItemView]
frame=false
interior=true
interior.element=itemview
text.normal.color=#ffffff
text.focus.color=#000000

[Splitter]
frame=false
interior=true
interior.element=splitter

[Scrollbar]
frame=false
interior=true
interior.element=scrollbargroove

[ScrollbarSlider]
frame=false
interior=true
interior.element=scrollbarslider

[ScrollbarTransientSlider]
inherits=ScrollbarSlider

[ScrollbarGroove]
inherits=Scrollbar

[MenuItem]
frame=false
interior=true
interior.element=menuitem
text.normal.color=#ffffff
text.focus.color=#000000
text.margin=4

[MenuBarItem]
inherits=MenuItem
interior.element=menubaritem

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow-down
indicator.size=8

[Menu]
frame=false
interior=true
interior.element=menu

[GroupBox]
frame=false
interior=false
text.normal.color=#ffffff

[ToolTip]
frame=false
interior=true
interior.element=tooltip
text.normal.color=#ffffff
text.margin=4

[StatusBar]
frame=false
interior=true
interior.element=toolbar

[Window]
interior=true
interior.element=window
