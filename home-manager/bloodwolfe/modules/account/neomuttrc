set header_cache = "~/.cache/neomutt/headers/"
set message_cachedir = "~/.cache/neomutt/messages/"
set editor = "$EDITOR"
set implicit_autoview = yes
set crypt_use_gpgme = yes
set crypt_autosign = yes
set crypt_opportunistic_encrypt = no
set pgp_use_gpg_agent = yes
set ssl_force_tls = yes
set certificate_file = /etc/ssl/certs/ca-certificates.crt
set mbox_type = Maildir
set sort = threads
set delete = yes
set signature = "~/.config/neomutt/signature"

alternative_order text/enriched text/plain text
mailboxes "/persist/home/bloodwolfe/.mail/tinywolfe/inbox" "/persist/home/bloodwolfe/.mail/bloodwolfe/inbox"

folder-hook /tinywolfe/ "source ~/.config/neomutt/accounts/tinywolfe"
folder-hook /bloodwolfe/ "source ~/.config/neomutt/accounts/google"
macro index,pager <f2> "<sync-mailbox><enter-command>source ~/.config/neomutt/accounts/tinywolfe<enter><change-folder>/persist/home/bloodwolfe/.mail/tinywolfe/inbox<enter>" "Tinywolfe account"
macro index,pager <f3> "<sync-mailbox><enter-command>source ~/.config/neomutt/accounts/google<enter><change-folder>/persist/home/bloodwolfe/.mail/bloodwolfe/inbox<enter>" "Google account"
macro index,pager ,u "<pipe-message>urlscan --single --run-safe 'xdg-open {}'<enter>" "Open a URL"

source ~/.config/neomutt/accounts/tinywolfe
